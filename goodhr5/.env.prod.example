# HRPlus 5 生产环境变量示例
#
# 用法：在服务器的 goodhr5/ 目录下复制为 .env 并填写真实值（.env 不提交 git）：
#   cp .env.prod.example .env
#   nano .env
#
# docker-compose.prod.yml 会自动读取本文件：既用于 postgres 服务建库，也注入后端进程。

# ===== 数据库（postgres 服务据此建库，后端据此拼接连接串）=====
POSTGRES_USER=goodhr5
POSTGRES_PASSWORD=请改成一段强密码
POSTGRES_DB=goodhr5

# ===== 站点地址（前端构建期注入，用于 sitemap、SEO、邀请链接）=====
# 填你的正式域名，结尾不要带斜杠；改这里后需要重新 build frontend 才生效。
SITE_URL=https://your-domain.com
# 前后端同域反代时留空即可，前端会自动走相对路径 /api/。
PUBLIC_API_BASE=

# ===== 后端运行环境 =====
# 生产必须是 prod：邮件会真实发送，缺依赖时启动日志会明确告警。
GOODHR_APP_ENV=prod
GOODHR_CLOUD_ADDR=:8084
# 注意：GOODHR_PG_DSN 与 GOODHR_REDIS_ADDR 由 docker-compose.prod.yml 依据上面的账号密码自动拼接，
# 这里不需要填写，填了也会被 compose 覆盖。

# ===== 超级管理员（逗号分隔邮箱，这些账号登录后拥有后台管理权限）=====
GOODHR_SUPER_ADMINS=you@yourdomain.com

# ===== 邮件 SMTP（生产发验证码/通知必须四项配齐，否则降级为不发真实邮件）=====
GOODHR_SMTP_HOST=smtp.yourdomain.com
GOODHR_SMTP_PORT=465
GOODHR_SMTP_USERNAME=noreply@yourdomain.com
GOODHR_SMTP_PASSWORD=邮箱授权码
GOODHR_SMTP_FROM=HR Plus <noreply@yourdomain.com>

# ===== 本地程序绑定开关（true 时本地 Agent 需绑定账号才能连后端）=====
GOODHR_AGENT_BINDING_ENABLED=true

# ===== 预留项（当前版本后端代码未读取，可留空）=====
GOODHR_ENCRYPTION_KEY=
