# GoodHR 5 云端后端环境变量配置示例
# 说明：本文件只是示例模板，真实配置写在同目录的 .env（已被 gitignore 忽略，不会提交）。
#      下面每项的取值均为代码里的默认值，密钥类留空，按需填写。

# ===== 运行环境 =====
# GOODHR_APP_ENV：运行环境模式，取值 dev（开发环境，默认）/ prod（生产环境）。
#   - dev：所有外部副作用关闭或本地化（例如验证码邮件只打印日志，不发真实邮件；本地数据库、Redis 可选）。
#   - prod：按真实依赖配置启用（需配齐 PG/Redis/SMTP 等），缺关键配置时启动会报错或降级并明确警告。
GOODHR_APP_ENV=dev

# ===== 服务地址与日志 =====
# GOODHR_CLOUD_ADDR：云端后端 HTTP 监听地址，默认 :8084。
GOODHR_CLOUD_ADDR=:8084
# GOODHR_CLOUD_LOG_FILE：日志文件路径，默认 logs/backend.log（相对后端启动目录）。
GOODHR_CLOUD_LOG_FILE=logs/backend.log

# ===== 数据库（PostgreSQL）=====
# GOODHR_PG_DSN：PostgreSQL 连接串；留空时后端回退为内存实现（仅供本地调试，重启丢数据）。
GOODHR_PG_DSN=

# ===== 缓存 / 会话（Redis，可选）=====
# GOODHR_REDIS_ADDR：Redis 地址；留空时相关存储回退为内存实现。
GOODHR_REDIS_ADDR=
# GOODHR_REDIS_PASSWORD：Redis 密码，无密码则留空。
GOODHR_REDIS_PASSWORD=
# GOODHR_REDIS_DB：Redis 库号，默认 0。
GOODHR_REDIS_DB=0

# ===== 超级管理员 =====
# GOODHR_SUPER_ADMINS：超级管理员邮箱列表，英文逗号分隔；留空时使用代码内置默认名单。
GOODHR_SUPER_ADMINS=

# ===== 邮件发送（SMTP）=====
# dev 环境下邮件只打印日志、不真实发送；prod 环境下列配置缺失会降级并告警。
# GOODHR_SMTP_HOST：SMTP 服务器地址。
GOODHR_SMTP_HOST=
# GOODHR_SMTP_PORT：SMTP 端口，默认 465。
GOODHR_SMTP_PORT=465
# GOODHR_SMTP_USERNAME：SMTP 登录账号。
GOODHR_SMTP_USERNAME=
# GOODHR_SMTP_PASSWORD：SMTP 登录密码 / 授权码。
GOODHR_SMTP_PASSWORD=
# GOODHR_SMTP_FROM：发件人地址。
GOODHR_SMTP_FROM=

# ===== 邮件任务与公网地址 =====
# GOODHR_PUBLIC_BASE_URL：站点公网地址，用于自动邮件里的「查看/追踪」链接；留空时回退到请求地址或邮件配置的网站地址。
GOODHR_PUBLIC_BASE_URL=
# GOODHR_EMAIL_JOB_TOKEN：定时邮件任务（如流程提醒）的鉴权令牌，留空则相关公共定时接口拒绝访问；生产建议填一段足够长的随机字符串。
GOODHR_EMAIL_JOB_TOKEN=

# ===== 登录验证码 =====
# GOODHR_UNIVERSAL_LOGIN_CODE_OFFSET_MINUTES：万能登录验证码的时间偏移量（分钟），默认 0；用于放宽基于时间的万能验证码校验窗口。
GOODHR_UNIVERSAL_LOGIN_CODE_OFFSET_MINUTES=0

# ===== 设备绑定 =====
# GOODHR_AGENT_BINDING_ENABLED：设备绑定冲突检测开关，默认 true。
#   - true：同一台电脑只能绑定一个账号，重复绑定会冲突。
#   - false：关闭冲突检测，同一台电脑可绑定多个账号（本地开发常用 false）。
GOODHR_AGENT_BINDING_ENABLED=true

# 微信支付参数已改为在后台「系统配置」页面的「微信支付配置」里在线维护，不再走环境变量。
