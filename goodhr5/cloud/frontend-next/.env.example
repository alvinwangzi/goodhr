# 站点地址（上线时替换为实际域名）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 云端 API 地址（上线时替换为实际域名）
NEXT_PUBLIC_CLOUD_API_BASE=https://your-domain.com

# 服务端专用云端 API 地址（仅 SSR 使用，不暴露给浏览器）；留空时回退到 NEXT_PUBLIC_CLOUD_API_BASE
CLOUD_API_BASE=

# 登录成功后暂时进入旧版后台；完全迁移后可改为 /admin/
NEXT_PUBLIC_LEGACY_ADMIN_URL=http://127.0.0.1:5173/admin/

# 静态导出开关；设为 1 时 Next.js 输出纯静态 HTML（用于 CDN 部署），部分服务端数据获取会跳过
GOODHR_STATIC_EXPORT=
